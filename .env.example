# Copy to .env and fill in (never commit .env)
# ---- Local LLM (default: Ollama on this machine) ----
# IMPORTANT: use a non-thinking (instruct) variant. Plain 'qwen3:4b' on
# Ollama resolves to the Thinking-2507 model, which ignores think=false and
# burns the token budget on chain-of-thought -> slow, empty replies.
JARVUS_LLM_BASE_URL=http://localhost:11434
JARVUS_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
JARVUS_LLM_NUM_CTX=8192         # 8192 is the sweet spot on 16 GB; don't go below it
JARVUS_LLM_THINK=false
JARVUS_LLM_KEEP_ALIVE=30m       # how long Ollama keeps the model in RAM; try 10m to free memory sooner
JARVUS_MAX_TOKENS=384           # short spoken replies; higher only for long-form output
# Slower but stronger reasoning: JARVUS_LLM_MODEL=qwen3:8b
# Remote server later: JARVUS_LLM_BASE_URL=http://your-server:11434

# ---- Voice ----
JARVUS_STT_ENGINE=auto          # auto | mlx | faster-whisper
JARVUS_STT_MODEL=small          # small=fast+lean (~0.5 GB); turbo=most accurate (~1.6 GB)
# Hallucination gates (raise if the mic hears phantom speech in a noisy room)
JARVUS_STT_NO_SPEECH_THRESHOLD=0.6   # drop segments above this whisper no_speech_prob
JARVUS_STT_MIN_LOGPROB=-1.0          # drop segments below this whisper avg_logprob (raise e.g. -0.7 to be stricter)
JARVUS_STT_SILENCE_RMS=0.003         # skip whisper entirely below this audio level (raise for loud rooms)
JARVUS_TTS_ENGINE=auto          # auto | kokoro | say
JARVUS_TTS_VOICE=af_heart       # kokoro voice id, or a macOS voice name
JARVUS_TTS_RATE=200
JARVUS_WAKE_WORDS=jarvis,jarvus,hey jarvis,hey jarvus

# ---- Remote access server (python -m app.main --serve) ----
JARVUS_SERVER_HOST=127.0.0.1
JARVUS_SERVER_PORT=8765
JARVUS_SERVER_TOKEN=            # REQUIRED if binding beyond localhost

# ---- OpenAI fallback (optional; not needed for 100% local) ----
JARVUS_OPENAI_API_KEY=
JARVUS_MODEL=gpt-4o-mini

# ---- Daily briefing ----
JARVUS_AUTO_BRIEF=auto            # auto (voice only) | on | off - speaks today's digest once/day
JARVUS_TOOL_PREFILTER=on          # on | off - shrink the tool schema payload sent to the LLM

# ---- Storage / misc ----
JARVUS_DATA_DIR=~/.jarvus
JARVUS_DB_PATH=
JARVUS_LOG_LEVEL=INFO
JARVUS_FS_ROOTS=                # extra file-sandbox roots, os.pathsep-separated
