# Copy to .env and fill in (never commit .env)
# ---- Local LLM (default: Ollama on this machine) ----
JARVUS_LLM_BASE_URL=http://localhost:11434
JARVUS_LLM_MODEL=qwen3:8b
JARVUS_LLM_NUM_CTX=16384
JARVUS_LLM_THINK=false
# Faster option: JARVUS_LLM_MODEL=qwen3:4b
# Remote server later: JARVUS_LLM_BASE_URL=http://your-server:11434

# ---- Voice ----
JARVUS_STT_ENGINE=auto          # auto | mlx | faster-whisper
JARVUS_STT_MODEL=small          # tiny|base|small|medium or mlx repo id
JARVUS_TTS_ENGINE=auto          # auto | kokoro | say
JARVUS_TTS_VOICE=af_heart       # kokoro voice id, or a macOS voice name
JARVUS_TTS_RATE=200
JARVUS_WAKE_WORDS=jarvis,jarvus,hey jarvis,hey jarvus

# ---- Remote access server (python -m app.main --serve) ----
JARVUS_SERVER_HOST=127.0.0.1
JARVUS_SERVER_PORT=8765
JARVUS_SERVER_TOKEN=            # REQUIRED if binding beyond localhost

# ---- OpenAI fallback (optional; not needed for 100% local) ----
JARVUS_OPENAI_API_KEY=
JARVUS_MODEL=gpt-4o-mini

# ---- Daily briefing ----
JARVUS_AUTO_BRIEF=auto            # auto (voice only) | on | off - speaks today's digest once/day
JARVUS_TOOL_PREFILTER=on          # on | off - shrink the tool schema payload sent to the LLM

# ---- Storage / misc ----
JARVUS_DATA_DIR=~/.jarvus
JARVUS_DB_PATH=
JARVUS_LOG_LEVEL=INFO
JARVUS_FS_ROOTS=                # extra file-sandbox roots, os.pathsep-separated
